# SQLAlchemy URL. SQLite needs no setup; Postgres example:
# DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
DATABASE_URL=sqlite:///./leadflow.db

# Comma-separated origins allowed to call the API directly from a browser.
# The Next.js app proxies /api/* to this server, so this only matters if you call the API from elsewhere.
CORS_ORIGINS=http://localhost:3000
