# Used by docker-compose.yml. Every value has a default, so copying this file is optional.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow
# "Yesterday at 4 PM" and similar seed times are computed in this timezone.
SEED_TIMEZONE=Asia/Kolkata

# Running without Docker? Each app has its own example:
#   backend/.env.example   DATABASE_URL, CORS_ORIGINS
#   frontend/.env.example  API_URL
